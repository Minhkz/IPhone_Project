<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="invoice_modern_bw"
        pageWidth="595"
        pageHeight="842"
        columnWidth="555"
        leftMargin="20"
        rightMargin="20"
        topMargin="20"
        bottomMargin="20"
        uuid="c2e1d010-2e7e-4a77-b6a3-f5a21348faaa">

    <!-- PARAMETERS -->
    <parameter name="orderId" class="java.lang.String"/>
    <parameter name="customerName" class="java.lang.String"/>
    <parameter name="phone" class="java.lang.String"/>
    <parameter name="address" class="java.lang.String"/>
    <parameter name="total" class="java.lang.Double"/>
    <parameter name="status" class="java.lang.String"/>

    <!-- FIELDS -->
    <field name="product" class="com.devpro.models.Product"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="price" class="java.lang.Double"/>

    <!-- TITLE -->
    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="20" isBold="true" fontName="VN-Arial"/>
                </textElement>
                <text><![CDATA[HÓA ĐƠN]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="40" width="555" height="1" forecolor="#000000"/>
            </line>
        </band>
    </title>

    <!-- HEADER INFO -->
    <pageHeader>
        <band height="90">
            <textField>
                <reportElement x="0" y="0" width="200" height="15"/>
                <textElement>
                    <font fontName="VN-Arial"/>
                </textElement>
                <textFieldExpression><![CDATA["ID: #" + $P{orderId}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="20" width="300" height="15"/>
                <textElement>
                    <font fontName="VN-Arial"/>
                </textElement>
                <textFieldExpression><![CDATA["Khách hàng: " + $P{customerName}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="40" width="300" height="15"/>
                <textElement>
                    <font fontName="VN-Arial"/>
                </textElement>
                <textFieldExpression><![CDATA["Số điện thoại: " + $P{phone}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="60" width="500" height="15"/>
                <textElement>
                    <font fontName="VN-Arial"/>
                </textElement>
                <textFieldExpression><![CDATA["Địa chỉ: " + $P{address}]]></textFieldExpression>
            </textField>

        </band>
    </pageHeader>

    <!-- COLUMN HEADER -->
    <columnHeader>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="555" height="25" backcolor="#000000" mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement x="0" y="0" width="30" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" fontName="VN-Arial"/>
                </textElement>
                <text><![CDATA[#]]></text>
            </staticText>

            <staticText>
                <reportElement x="40" y="0" width="220" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" fontName="VN-Arial"/>
                </textElement>
                <text><![CDATA[Tên sản phẩm]]></text>
            </staticText>

            <staticText>
                <reportElement x="270" y="0" width="70" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" fontName="VN-Arial"/>
                </textElement>
                <text><![CDATA[Số lượng]]></text>
            </staticText>

            <staticText>
                <reportElement x="350" y="0" width="90" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" fontName="VN-Arial"/>
                </textElement>
                <text><![CDATA[Giá (VND)]]></text>
            </staticText>

            <staticText>
                <reportElement x="460" y="0" width="95" height="25" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true" fontName="VN-Arial"/>
                </textElement>
                <text><![CDATA[Thành tiền (VND)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- DETAIL -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="30" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="40" y="0" width="220" height="20"/>
                <textFieldExpression><![CDATA[$F{product}.getName()]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="270" y="0" width="70" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="350" y="0" width="90" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[String.format("%,.0f", $F{price})]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="460" y="0" width="95" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[String.format("%,.0f", $F{price} * $F{quantity})]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- SUMMARY -->
    <summary>
        <band height="60">
            <line>
                <reportElement x="350" y="0" width="205" height="1" forecolor="#000000"/>
            </line>
            <staticText>
                <reportElement x="350" y="10" width="100" height="15"/>
                <textElement>
                    <font fontName="VN-Arial"/>
                </textElement>
                <text><![CDATA[Tổng cộng:]]></text>
            </staticText>
            <textField>
                <reportElement x="450" y="10" width="100" height="15"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[String.format("%,.0f VND", $P{total})]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
